#!/usr/bin/env python3
"""bin/release — 发行门禁、tag 创建与推送的机械面。

Prism 的发行单位是不可变 annotated tag。三个动作被刻意拆开，因为它们
的可逆性完全不同：

- ``check`` 只回答「这个 HEAD 能不能发这个 tag」，不产生任何外部影响；
- ``tag`` 只在本机创建 annotated tag，且强制先通过 check；
- ``push`` 是唯一会产生外部写入的动作，必须显式 ``--confirm``，否则只
  打印将要执行的命令，不碰远端。

分支上的普通 commit 不是发行事件，因此 check 会要求工作树干净且与
upstream 同步：发布点必须能被任何人重新检出同一个 commit。
"""

from __future__ import annotations

import argparse
import importlib.util
import json
import subprocess
import sys
from pathlib import Path

SDK_ROOT = Path(__file__).resolve().parents[1]
OK = "ok"
WARN = "warn"
FAIL = "fail"


def _load_module(name: str, filename: str):
    """按文件路径加载 bin/ 下的自包含脚本，供本入口复用其纯函数。"""
    path = SDK_ROOT / "bin" / filename
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"无法加载 {path}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def _git(repo: Path, args: list[str]) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", *args],
        cwd=str(repo),
        capture_output=True,
        text=True,
        timeout=60,
    )


def _step(name: str, status: str, detail: str) -> dict:
    return {"name": name, "status": status, "detail": detail}


def _worktree_clean(repo: Path) -> dict:
    result = _git(repo, ["status", "--porcelain"])
    if result.returncode != 0:
        return _step("worktree-clean", FAIL, result.stderr.strip() or "git status 失败")
    if result.stdout.strip():
        return _step("worktree-clean", FAIL, "工作树有未提交变更，发布点必须可重新检出")
    return _step("worktree-clean", OK, "工作树干净")


def _upstream_synced(repo: Path) -> dict:
    ahead = _git(repo, ["rev-list", "--count", "@{upstream}..HEAD"])
    behind = _git(repo, ["rev-list", "--count", "HEAD..@{upstream}"])
    if ahead.returncode != 0 or behind.returncode != 0:
        return _step("upstream-synced", FAIL, "当前分支没有 upstream，无法证明发布点已同步")
    if ahead.stdout.strip() != "0":
        return _step("upstream-synced", FAIL, f"本地领先 upstream {ahead.stdout.strip()} 个 commit")
    if behind.stdout.strip() != "0":
        return _step("upstream-synced", FAIL, f"本地落后 upstream {behind.stdout.strip()} 个 commit")
    return _step("upstream-synced", OK, "HEAD 与 upstream 同步")


def _tag_absent(repo: Path, tag: str) -> dict:
    local = _git(repo, ["tag", "--list", tag])
    if local.returncode == 0 and tag in local.stdout.split():
        return _step("tag-absent", FAIL, f"tag {tag} 已存在；已发布的 tag 不可重写")
    branch = _git(repo, ["symbolic-ref", "-q", "--short", "HEAD"])
    branch_name = branch.stdout.strip() if branch.returncode == 0 else ""
    remote = _git(repo, ["config", "--get", f"branch.{branch_name}.remote"])
    remote_name = remote.stdout.strip() if remote.returncode == 0 else ""
    if not remote_name:
        return _step("tag-absent", FAIL, "无法定位 upstream remote，不能确认远端 tag 是否未占用")
    remote_tag = _git(repo, ["ls-remote", "--tags", remote_name, f"refs/tags/{tag}"])
    if remote_tag.returncode != 0:
        return _step("tag-absent", FAIL, remote_tag.stderr.strip() or "读取远端 tag 失败")
    if remote_tag.stdout.strip():
        return _step("tag-absent", FAIL, f"远端 tag {tag} 已存在；不可重写")
    return _step("tag-absent", OK, f"本地与远端 tag {tag} 均未占用")


def _branch_matches(repo: Path, expected: str) -> dict:
    """校验 tag 打在预期的分支上。

    两条发布线长期并存：实验线出 canary tag，稳定线出 stable tag。tag 名
    本身已经能区分 channel，但「在稳定线上顺手打出 canary.2」不会体现在
    tag 名里，只能靠发行时的分支校验兜住。不给 --expect-branch 就不校验，
    下一轮实验想换分支发版时不必修改实现。
    """
    result = _git(repo, ["symbolic-ref", "-q", "--short", "HEAD"])
    current = result.stdout.strip() if result.returncode == 0 else ""
    if not current:
        return _step("branch-matches", FAIL, f"HEAD 不在分支上，无法校验是否为 {expected}")
    if current != expected:
        return _step("branch-matches", FAIL, f"当前分支是 {current}，期望 {expected}")
    return _step("branch-matches", OK, f"当前分支 {current} 与期望一致")


def _tag_grammar(tag: str) -> dict:
    resolver = _load_module("tag_resolve", "tag_resolve.py")
    parsed = resolver.parse_tag(tag)
    if parsed is None:
        return _step(
            "tag-grammar",
            FAIL,
            f"{tag} 不符合 canary vX.Y.Z-canary.N 或 stable vX.Y.Z 形态",
        )
    return _step(
        "tag-grammar",
        OK,
        f"{tag} → {parsed['channel']} / package {parsed['package_version']}",
    )


def _version_metadata(repo: Path, tag: str) -> dict:
    gate = _load_module("release_gate", "release_gate.py")
    result = gate.scan(repo, "", "", expected_tag=tag)
    metadata = result.get("version_metadata", {})
    if not metadata.get("ok"):
        errors = "; ".join(item.get("message", "") for item in result.get("errors", []))
        return _step("version-metadata", FAIL, errors or "版本元数据不一致")

    release = (metadata.get("release") or "").strip()
    return _step("version-metadata", OK, f"VERSION {release} 与 tag 一致")


def _release_gate(repo: Path, base: str, head: str) -> dict:
    if not base or not head:
        return _step(
            "release-gate",
            FAIL,
            "release check 必须显式提供 --base 与 --head，不能跳过 diff evidence",
        )
    gate = _load_module("release_gate", "release_gate.py")
    try:
        result = gate.scan(repo, base, head)
    except RuntimeError as error:
        return _step("release-gate", FAIL, str(error))
    if result.get("ok"):
        return _step("release-gate", OK, "release gate 通过")
    errors = "; ".join(item.get("message", "") for item in result.get("errors", []))
    return _step("release-gate", FAIL, errors or "release gate 失败")


def _command_step(name: str, command: list[str], repo: Path) -> dict:
    completed = subprocess.run(
        command,
        cwd=str(repo),
        capture_output=True,
        text=True,
        timeout=900,
    )
    if completed.returncode == 0:
        return _step(name, OK, "通过")
    tail = (completed.stdout + completed.stderr).strip().splitlines()
    return _step(name, FAIL, tail[-1] if tail else f"退出码 {completed.returncode}")


def _test_surface(repo: Path) -> list[dict]:
    return [
        _command_step("pytest", ["uv", "run", "pytest"], repo),
        _command_step(
            "relink-writeback",
            ["bash", "tests/test_relink_writeback.sh"],
            repo,
        ),
        _command_step(
            "skill-validation",
            ["bin/validate-skills", "--layer", "sdk"],
            repo,
        ),
        _command_step("setup-check", ["./setup.sh", "check"], repo),
    ]


def run_check(
    repo: Path,
    tag: str,
    base: str = "",
    head: str = "",
    skip_tests: bool = False,
    expect_branch: str | None = None,
) -> dict:
    steps = []
    if expect_branch:
        # 分支不对时后面几项检查没有意义，因此排在最前面。
        steps.append(_branch_matches(repo, expect_branch))
    steps.extend(
        [
            _worktree_clean(repo),
            _upstream_synced(repo),
            _tag_absent(repo, tag),
            _tag_grammar(tag),
            _version_metadata(repo, tag),
            _release_gate(repo, base, head),
        ]
    )
    if not skip_tests:
        steps.extend(_test_surface(repo))
    return {
        "ok": all(step["status"] != FAIL for step in steps),
        "tag": tag,
        "steps": steps,
    }


def cmd_check(args: argparse.Namespace) -> int:
    repo = Path(args.repo).resolve()
    result = run_check(
        repo, args.tag, args.base, args.head, args.skip_tests, args.expect_branch
    )
    if args.json:
        print(json.dumps(result, ensure_ascii=False))
    else:
        print(f"release check {args.tag}")
        print("─────────────────────────────────")
        for step in result["steps"]:
            mark = {OK: "✓", WARN: "⚠", FAIL: "✗"}[step["status"]]
            print(f"  {mark} {step['name']}: {step['detail']}")
        print("─────────────────────────────────")
        print("可发布" if result["ok"] else "存在阻断项")
    return 0 if result["ok"] else 1


def cmd_tag(args: argparse.Namespace) -> int:
    repo = Path(args.repo).resolve()
    result = run_check(
        repo, args.tag, args.base, args.head, args.skip_tests, args.expect_branch
    )
    if not result["ok"]:
        print("check 未通过，拒绝创建 tag；先修复上面的阻断项。", file=sys.stderr)
        if args.json:
            print(json.dumps(result, ensure_ascii=False))
        return 1

    message = args.message or f"Prism {args.tag}"
    if args.dry_run:
        print(f"[dry-run] git tag -a {args.tag} -m {message!r}")
        return 0
    completed = _git(repo, ["tag", "-a", args.tag, "-m", message])
    if completed.returncode != 0:
        print(completed.stderr.strip() or "创建 tag 失败", file=sys.stderr)
        return completed.returncode
    print(f"已在本机创建 annotated tag {args.tag}；推送是独立动作：bin/release push --tag {args.tag}")
    return 0


def cmd_push(args: argparse.Namespace) -> int:
    repo = Path(args.repo).resolve()
    listing = _git(repo, ["tag", "--list", args.tag])
    if args.tag not in listing.stdout.split():
        print(f"本机不存在 tag {args.tag}，先运行 bin/release tag。", file=sys.stderr)
        return 1

    resolver = _load_module("tag_resolve", "tag_resolve.py")
    parsed = resolver.parse_tag(args.tag)
    if parsed is None:
        print(f"{args.tag} 不是合法 release tag，拒绝推送。", file=sys.stderr)
        return 1
    object_type = _git(repo, ["cat-file", "-t", args.tag])
    if object_type.returncode != 0 or object_type.stdout.strip() != "tag":
        print(f"{args.tag} 不是 annotated tag，拒绝推送。", file=sys.stderr)
        return 1
    version = _git(repo, ["show", f"{args.tag}^{{commit}}:VERSION"])
    expected_release = args.tag.removeprefix("v")
    if version.returncode != 0 or version.stdout.strip() != expected_release:
        print(
            f"{args.tag} 指向的 VERSION 不是 {expected_release}，拒绝推送。",
            file=sys.stderr,
        )
        return 1

    command = ["push", args.remote, args.tag]
    if not args.confirm:
        # 唯一会产生外部写入的动作，默认只展示，避免把它当成顺手的收尾步骤。
        print("[dry-run] git " + " ".join(command))
        print("确认后追加 --confirm 才会真正推送。")
        return 0

    completed = _git(repo, command)
    if completed.returncode != 0:
        print(completed.stderr.strip() or "推送失败", file=sys.stderr)
        return completed.returncode
    print(f"已推送 {args.tag} 到 {args.remote}")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Prism release mechanical surface")
    parser.add_argument("--repo", default=str(SDK_ROOT), help="SDK 仓库路径")
    subparsers = parser.add_subparsers(dest="action", required=True)

    check = subparsers.add_parser("check", help="校验某个 tag 能否发布")
    check.add_argument("--tag", required=True)
    check.add_argument("--base", default="", help="release gate diff 起点")
    check.add_argument("--head", default="", help="release gate diff 终点")
    check.add_argument("--skip-tests", action="store_true", help="跳过 pytest / relink / skill / setup 面")
    check.add_argument("--expect-branch", default=None, help="校验当前分支名，防止在错误的发布线上打 tag")
    check.add_argument("--json", action="store_true")
    check.set_defaults(func=cmd_check)

    tag = subparsers.add_parser("tag", help="通过 check 后在本机创建 annotated tag")
    tag.add_argument("--tag", required=True)
    tag.add_argument("--base", default="")
    tag.add_argument("--head", default="")
    tag.add_argument("--skip-tests", action="store_true")
    tag.add_argument("--message", default=None, help="annotated tag 说明")
    tag.add_argument("--expect-branch", default=None, help="校验当前分支名，防止在错误的发布线上打 tag")
    tag.add_argument("--dry-run", action="store_true")
    tag.add_argument("--json", action="store_true")
    tag.set_defaults(func=cmd_tag)

    push = subparsers.add_parser("push", help="推送已创建的 tag；必须显式 --confirm")
    push.add_argument("--tag", required=True)
    push.add_argument("--remote", default="origin")
    push.add_argument("--confirm", action="store_true", help="真正执行推送；不加则只打印")
    push.set_defaults(func=cmd_push)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
