#!/usr/bin/env python3
"""prism update — 按不可变 Git tag 更新 Prism 安装。

产品更新的单位是 tag，不是分支上的 commit：managed install 固定在一个
detached release tag 上，updater 只认当前通道里更新的不可变 tag，没有
新 tag 就什么都不做。

分支 checkout 属于贡献者的 source line，产品更新默认不接管：把工作副本
从分支移到 tag 是一次不可逆的方向变化，只有显式 ``--bootstrap-to`` 才做。
外部 prism-skills 是独立仓库，由 ``prism-maintain`` 管理，不进入产品更新事务。
"""

from __future__ import annotations

import argparse
import importlib.util
import json
import re
import subprocess
import sys
from pathlib import Path

SDK_ROOT = Path(__file__).resolve().parents[1]
DEFAULT_CONFIG = SDK_ROOT / "prism.local.yaml"

MANAGED = "managed"
SOURCE = "source"
DETACHED = "detached"

MAJOR_RE = re.compile(r"(\d+)")


def _load_tag_resolve():
    path = SDK_ROOT / "bin" / "tag_resolve.py"
    spec = importlib.util.spec_from_file_location("tag_resolve", path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"无法加载 {path}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def _git(repo: Path, args: list[str], timeout: int = 60) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", *args],
        cwd=str(repo),
        capture_output=True,
        text=True,
        timeout=timeout,
        check=False,
    )


def _current_branch(repo: Path) -> str | None:
    result = _git(repo, ["symbolic-ref", "-q", "--short", "HEAD"])
    if result.returncode != 0:
        return None
    return result.stdout.strip() or None


def _current_tag(repo: Path) -> str | None:
    result = _git(repo, ["describe", "--tags", "--exact-match", "HEAD"])
    if result.returncode != 0:
        return None
    return result.stdout.strip() or None


def detect_install_mode(repo: Path) -> str:
    if _current_branch(repo):
        return SOURCE
    return MANAGED if _current_tag(repo) else DETACHED


def _is_dirty(repo: Path) -> bool:
    result = _git(repo, ["status", "--porcelain"])
    if result.returncode != 0:
        return True
    return bool(result.stdout.strip())


def _infer_series(repo: Path) -> int | None:
    """series 跟随当前安装的 major，让 major 升级成为显式动作。"""
    current = _current_tag(repo)
    source = current or _read_version(repo) or ""
    match = MAJOR_RE.search(source)
    return int(match.group(1)) if match else None


def _read_version(repo: Path) -> str | None:
    try:
        return (repo / "VERSION").read_text(encoding="utf-8").strip() or None
    except OSError:
        return None


def _blocked(reason: str, **extra) -> dict:
    """构造阻断结果；控制字段最后写入，不被调用方的上下文覆盖。"""
    payload = dict(extra)
    payload["ok"] = False
    payload["action"] = "blocked"
    payload["reason"] = reason
    payload["writes"] = 0
    return payload


def _resolve_channel(
    resolver, config: Path, args: argparse.Namespace
) -> tuple[str | None, int | None, bool]:
    """返回 (channel, series, 成功后是否需要持久化配置)。"""
    stored_channel, stored_series = resolver.read_channel(config)

    if args.check or args.dry_run:
        # --check / --dry-run 是只读动作，不能顺手把通道选择落盘。
        return args.channel or stored_channel, args.series or stored_series, False

    if args.channel:
        series = args.series or stored_series or _infer_series(Path(args.repo)) or 4
        return args.channel, series, True

    return stored_channel, stored_series, False


def _validate_target(resolver, tags: list[str], tag: str, channel: str, series: int | None) -> dict | None:
    parsed = resolver.parse_tag(tag)
    if parsed is None:
        return None
    if parsed["channel"] != channel:
        return None
    if series is not None and parsed["major"] != series:
        return None
    return parsed if tag in tags else None


def _switch_to_tag(repo: Path, tag: str) -> bool:
    return _git(repo, ["checkout", "--detach", tag], timeout=300).returncode == 0


def _post_switch_checks(repo: Path) -> bool:
    """切换后的体检与重链；任一失败都要由调用方回滚。

    体检用 ``ci`` scope：它不读本机配置、不依赖 PATH 锚点，因此切换后的
    自检不会因为「这台机器还没配好」而误判成版本问题。
    """
    doctor = subprocess.run(
        [str(repo / "bin" / "doctor"), "--scope", "ci"],
        cwd=str(repo),
        capture_output=True,
        text=True,
        timeout=300,
        check=False,
    )
    if doctor.returncode not in (0, 2):
        # bin/doctor：0=全绿，1=ERROR，2=仅 WARN — WARN 不阻断安装。
        return False
    relink = subprocess.run(
        [str(repo / "bin" / "relink"), "--no-workspace"],
        cwd=str(repo),
        capture_output=True,
        text=True,
        timeout=300,
        check=False,
    )
    return relink.returncode == 0


def _rollback(repo: Path, previous_branch: str | None, previous_sha: str) -> bool:
    """回到切换前的 commit，并重跑旧版本的 relink 让软链接状态自洽。

    回滚用 SHA 而不是 tag 名：tag 理论上可以被移动，而这次切换前的 commit
    是唯一确定的事实。
    """
    try:
        if previous_branch:
            checkout = _git(repo, ["checkout", previous_branch], timeout=300)
            if checkout.returncode == 0:
                checkout = _git(repo, ["reset", "--hard", previous_sha], timeout=300)
        else:
            checkout = _git(repo, ["checkout", "--detach", previous_sha], timeout=300)
        if checkout.returncode != 0:
            return False
        relink = subprocess.run(
            [str(repo / "bin" / "relink"), "--no-workspace"],
            cwd=str(repo),
            capture_output=True,
            text=True,
            timeout=300,
            check=False,
        )
        current = _git(repo, ["rev-parse", "HEAD"])
        return (
            relink.returncode == 0
            and current.returncode == 0
            and current.stdout.strip() == previous_sha
        )
    except (OSError, subprocess.SubprocessError):
        return False


def _track_branch(repo: Path, mode: str, args: argparse.Namespace) -> dict:
    """分支 checkout 的 commit 级跟进。

    它跟随当前 upstream 的分支 commit，不是发行版本——这一点必须写在
    输出里：把「拉到了分支最新」误读成「装上了某个 release」，正是
    tag 发行要杜绝的事情。
    """
    if mode == MANAGED:
        return _blocked(
            "当前是 managed 安装（detached 在 release tag 上）；分支跟进不适用，"
            "请用 prism update 走 tag 通道",
            mode=mode,
        )
    if mode != SOURCE:
        return _blocked("--track-branch 需要分支 checkout，当前 HEAD 既不在分支也不在 tag 上")

    branch = _current_branch(repo)
    payload: dict = {
        "ok": True,
        "mode": mode,
        "branch": branch,
        "action": "track-branch",
        "writes": 0,
        "release": False,
    }

    if not args.no_fetch:
        fetch = _git(repo, ["fetch", "--quiet"], timeout=300)
        if fetch.returncode != 0:
            return _blocked("无法刷新当前分支的 upstream 状态", **payload)

    ahead = _git(repo, ["rev-list", "--count", "@{upstream}..HEAD"])
    behind = _git(repo, ["rev-list", "--count", "HEAD..@{upstream}"])
    if ahead.returncode != 0 or behind.returncode != 0:
        return _blocked("当前分支没有可用 upstream，不能安全跟进", **payload)
    ahead_count = int(ahead.stdout.strip())
    behind_count = int(behind.stdout.strip())
    payload["ahead"] = ahead_count
    payload["behind"] = behind_count

    if ahead_count > 0 and behind_count > 0:
        return _blocked(
            "当前分支与 upstream 已分叉；交给 prism-maintain 判断方向，不自动 rebase",
            **payload,
        )

    if args.check:
        payload["action"] = "update" if behind_count > 0 else "noop"
        if behind_count > 0:
            payload["detail"] = f"分支 {branch} 落后 upstream {behind_count} 个 commit"
        elif ahead_count > 0:
            payload["detail"] = f"分支 {branch} 本地领先 upstream {ahead_count} 个 commit；不会自动 push"
        else:
            payload["detail"] = f"分支 {branch} 已与 upstream 对齐"
        if _is_dirty(repo):
            payload["detail"] += "；工作树有未提交变更，实际跟进前需先 commit/stash"
        return payload

    if args.dry_run:
        payload["detail"] = f"[dry-run] git pull --ff-only（分支 {branch}）"
        return payload

    if behind_count == 0:
        payload["action"] = "noop"
        payload["detail"] = (
            f"分支 {branch} 本地领先 upstream {ahead_count} 个 commit；未执行写入"
            if ahead_count > 0
            else f"分支 {branch} 已与 upstream 对齐"
        )
        return payload

    previous_sha = _git(repo, ["rev-parse", "HEAD"]).stdout.strip()
    pull = _git(repo, ["pull", "--ff-only"], timeout=300)
    if pull.returncode != 0:
        payload["detail"] = "git pull --ff-only 失败"
        return _blocked(
            "分支跟进失败；若存在冲突或分叉，交给 prism-maintain 的方向判断与冲突协助",
            **payload,
        )

    try:
        checks_ok = _post_switch_checks(repo)
    except (OSError, subprocess.SubprocessError):
        checks_ok = False
    if not checks_ok:
        rolled_back = _rollback(repo, branch, previous_sha)
        payload["detail"] = "分支更新后体检未通过"
        return _blocked(
            "跟进后体检未通过，已回滚" if rolled_back else "跟进后体检未通过且自动回滚失败，需人工恢复",
            **payload,
        )

    payload["writes"] = 1
    payload["detail"] = f"已跟随分支 {branch} 更新到最新 commit（source 模式，不是 release 版本）"
    return payload


def run_update(args: argparse.Namespace) -> dict:
    repo = Path(args.repo).resolve()
    config = Path(args.config).resolve() if args.config else repo / "prism.local.yaml"
    resolver = _load_tag_resolve()

    if not (repo / ".git").exists():
        return _blocked("不是 Git 仓库，无法进行 tag 更新")

    dirty = _is_dirty(repo)
    if dirty and not args.check:
        # --check 是只读的，不移动 HEAD，因此即使工作树脏也要能给出判断——
        # 维护者想知道「我落后多少」时，不该被要求先清理工作区。
        return _blocked("工作树有未提交变更；更新会移动 HEAD，请先 commit/stash")

    mode = detect_install_mode(repo)
    if args.track_branch:
        # 分支跟进不需要通道选择：它跟的是 commit，不是发行版本。
        return _track_branch(repo, mode, args)
    if mode == DETACHED:
        return _blocked("当前 HEAD 既不在分支也不在 tag 上，先切到一个 release tag 或分支")

    if mode == SOURCE and args.check:
        return {
            "ok": True,
            "mode": SOURCE,
            "branch": _current_branch(repo),
            "action": "source",
            "writes": 0,
            "release": False,
            "detail": "source checkout 由 Git 管理；需要机械跟进时显式使用 --track-branch",
        }

    channel, series, persist_channel = _resolve_channel(resolver, config, args)
    if channel is None:
        return _blocked(
            "尚未选择更新通道；先运行 prism update --channel canary|stable",
            mode=mode,
        )
    if series is None:
        series = _infer_series(repo)

    bootstrap = bool(args.bootstrap_tag)
    if mode == SOURCE and not bootstrap:
        return _blocked(
            "当前是分支 checkout（source 模式），产品更新不接管分支："
            "贡献者用 Git 自行管理，或用 --track-branch 做 commit 级跟进、"
            "--bootstrap-to <tag> 迁移到 managed 安装",
            mode=mode,
            channel=channel,
            series=series,
        )

    if not args.no_fetch:
        fetch = _git(repo, ["fetch", "--tags", "--prune", "--quiet"], timeout=300)
        if fetch.returncode != 0:
            return _blocked("无法拉取远端 tag，稍后重试或检查远端配置", mode=mode, channel=channel)

    tags = resolver.collect_tags(repo)
    if bootstrap:
        target = _validate_target(resolver, tags, args.bootstrap_tag, channel, series)
        if target is None:
            return _blocked(
                f"{args.bootstrap_tag} 不是当前通道（{channel}）中可用的 tag",
                mode=mode,
                channel=channel,
                series=series,
            )
    elif args.target_tag:
        target = _validate_target(resolver, tags, args.target_tag, channel, series)
        if target is None:
            return _blocked(
                f"{args.target_tag} 不存在，或不属于当前通道（{channel}）与系列（{series}）",
                mode=mode,
                channel=channel,
                series=series,
            )
    else:
        target = resolver.select_latest(tags, channel, series)
        if target is None:
            return _blocked(
                f"通道 {channel} 中还没有可用 tag",
                mode=mode,
                channel=channel,
                series=series,
            )

    current = _current_tag(repo)
    latest = resolver.select_latest(tags, channel, series)
    payload = {
        "ok": True,
        "mode": mode,
        "channel": channel,
        "series": series,
        "current_tag": current,
        "latest_tag": latest["tag"] if latest else None,
        "target_tag": target["tag"],
        "writes": 0,
    }

    if args.check:
        payload["action"] = "noop" if current == target["tag"] else "update"
        if dirty:
            payload["detail"] = "工作树有未提交变更，实际更新前需先 commit/stash"
        return payload

    if not bootstrap and current == target["tag"]:
        if persist_channel:
            try:
                resolver.write_channel(config, channel, series)
            except OSError as error:
                return _blocked(f"版本未变化，但通道配置写入失败：{error}", **payload)
            payload["writes"] = 1
        payload["action"] = "noop"
        payload["detail"] = f"已是通道 {channel} 的最新版本 {target['tag']}"
        return payload

    previous_branch = _current_branch(repo)
    previous_sha = _git(repo, ["rev-parse", "HEAD"]).stdout.strip()
    payload["action"] = "bootstrap" if bootstrap else "update"

    if args.dry_run:
        payload["detail"] = f"[dry-run] git checkout --detach {target['tag']}"
        return payload

    if not _switch_to_tag(repo, target["tag"]):
        return _blocked(f"切换到 {target['tag']} 失败", **payload)

    try:
        checks_ok = _post_switch_checks(repo)
    except (OSError, subprocess.SubprocessError):
        checks_ok = False
    if not checks_ok:
        rolled_back = _rollback(repo, previous_branch, previous_sha)
        return _blocked(
            (
                f"切换到 {target['tag']} 后体检未通过，已回滚到 {previous_sha[:12]}"
                if rolled_back
                else f"切换到 {target['tag']} 后体检未通过，自动回滚失败，需人工恢复 {previous_sha[:12]}"
            ),
            **payload,
        )

    if persist_channel:
        try:
            resolver.write_channel(config, channel, series)
        except OSError as error:
            rolled_back = _rollback(repo, previous_branch, previous_sha)
            return _blocked(
                (
                    f"通道配置写入失败，已回滚到 {previous_sha[:12]}：{error}"
                    if rolled_back
                    else f"通道配置写入失败且自动回滚失败，需人工恢复 {previous_sha[:12]}：{error}"
                ),
                **payload,
            )
        payload["writes"] += 1

    payload["detail"] = f"已切换到 {target['tag']}"
    payload["writes"] += 1
    return payload


def _render(payload: dict) -> None:
    if payload.get("action") == "blocked":
        print(f"✗ {payload['reason']}")
        return

    if payload.get("release") is False:
        # 分支跟进的输出不谈 tag：一旦出现 current tag / latest tag 字样，
        # 就很容易被读成「装上了某个 release 版本」。
        print(f"mode:        {payload['mode']}")
        print(f"branch:      {payload.get('branch') or '-'}")
        print(f"action:      {payload['action']} (commit 级，非发行版本)")
        if payload.get("detail"):
            print(payload["detail"])
        return

    print(f"mode:        {payload['mode']}")
    print(f"channel:     {payload['channel']} (series {payload['series']})")
    print(f"current tag: {payload.get('current_tag') or '-'}")
    print(f"latest tag:  {payload.get('latest_tag') or '-'}")
    print(f"action:      {payload['action']}")
    if payload.get("detail"):
        print(payload["detail"])


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="prism update",
        description="按不可变 Git tag 更新 Prism 安装",
    )
    parser.add_argument("--channel", choices=["canary", "stable"], default=None)
    parser.add_argument("--series", type=int, default=None, help="跟随的 major 系列")
    parser.add_argument("--to", dest="target_tag", default=None, help="精确切换到指定 tag（调试 / 回滚）")
    parser.add_argument("--bootstrap-to", dest="bootstrap_tag", default=None,
                        help="从分支 checkout 一次性迁移到 managed 安装")
    parser.add_argument("--track-branch", action="store_true",
                        help="分支 checkout 专用：跟随当前 upstream 做 commit 级跟进，不是发行版本")
    parser.add_argument("--check", action="store_true", help="只报告当前 / 通道 / 最新 / 动作，零写入")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--no-fetch", action="store_true", help="跳过 fetch，只用本地已有 tag")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--repo", default=str(SDK_ROOT))
    parser.add_argument("--config", default=None)
    args = parser.parse_args(argv)

    if args.track_branch and (args.channel or args.target_tag or args.bootstrap_tag):
        # 两条链路的语义互斥：一个是 commit 级跟进，一个是发行版本切换。
        print(
            "error: --track-branch 不能与 --channel / --to / --bootstrap-to 混用",
            file=sys.stderr,
        )
        return 2

    try:
        payload = run_update(args)
    except RuntimeError as error:
        print(f"✗ {error}", file=sys.stderr)
        return 127

    if args.json:
        print(json.dumps(payload, ensure_ascii=False))
    else:
        _render(payload)
    return 0 if payload.get("ok") else 1


if __name__ == "__main__":
    raise SystemExit(main())
