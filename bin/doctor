#!/usr/bin/env bash
# Prism doctor — 统一健康检查入口，编排 setup / validate / sniff / relink 四件套。
#
# 用法:
#   bin/doctor                    完整体检（仓库+配置+链接+skill+同步状态）
#   bin/doctor --quick            快速模式，跳过访问远程的 sniff
#   bin/doctor --fix              非破坏性自动修复（validate --fix + relink + cli 注入）
#   bin/doctor --rollback         回滚 --fix 的修改（删除 rc 锚点 + symlink）
#   bin/doctor --json             JSON 输出供其他 skill 消费
#   bin/doctor --scope <name>     只跑指定范围：env / config / link / skill / sync / cli / release / ci
#
#   scope 说明:
#     env       setup --check 的环境完整性
#     skill     validate-skills 的 frontmatter 合规
#     cli       doctor_cli 的 prism 寻址体检
#     config    prism.local.yaml 必填字段 + 路径可达性
#     release   聚合以上全部（1.0 发布就绪闸门）
#     ci        env + skill + cli（跳过 sync 远端访问；vault 路径不可达只 INFO 不计警告）
#
#   --output <path>  将 JSON 结果写入文件（自动启用 --json）
#
# 退出码:
#   0  完全健康
#   1  有 ERROR（阻断性）
#   2  只有 WARN（不阻断但提示）

set -o pipefail  # 不要 set -e，避免 `! $JSON && echo` 写法触发误伤

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PRISM_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
DIM='\033[2m'
NC='\033[0m'

QUICK=false
FIX=false
ROLLBACK=false
JSON=false
SCOPE=""
OUTPUT=""

# 各阶段计数
ERR_ENV=0;    WARN_ENV=0
ERR_SKILL=0;  WARN_SKILL=0; FIX_SKILL=0
ERR_CLI=0;    WARN_CLI=0;   FIX_CLI=0
ERR_CONFIG=0; WARN_CONFIG=0; FIX_CONFIG=0
ERR_CI_HEALTH=0; WARN_CI_HEALTH=0

# 解析参数
while [[ $# -gt 0 ]]; do
  case "$1" in
    --quick)  QUICK=true; shift ;;
    --fix)    FIX=true; shift ;;
    --rollback) ROLLBACK=true; shift ;;
    --json)   JSON=true; shift ;;
    --scope)
      [[ $# -lt 2 ]] && { echo -e "${RED}✗ --scope 需要参数${NC}" >&2; exit 1; }
      SCOPE="$2"; shift 2 ;;
    --output)
      [[ $# -lt 2 ]] && { echo -e "${RED}✗ --output 需要参数${NC}" >&2; exit 1; }
      OUTPUT="$2"; JSON=true; shift 2 ;;
    --help|-h)
      awk 'NR==1 { next } /^$/ { exit } { sub(/^# ?/, ""); print }' "$0"
      exit 0 ;;
    *) echo -e "${RED}✗ 未知参数: $1${NC}" >&2; exit 1 ;;
  esac
done

# ── 判定 scope 是否激活某阶段 ────────
# release scope 聚合全部 4 个阶段（env/skill/cli/config）；
# ci scope 聚合 skill + ci_health（自包含：bin/* +x、bin/prism --version 可启动），
#   跳过 env（依赖 prism.local.yaml）/ cli（依赖 ~/.local/bin / PATH 锚点）
#   / config（依赖 named workspaces 等本机字段）—— CI runner 无 prism.local.yaml 也能跑通；
# 普通 scope 只激活同名阶段
_in_scope() {
  [[ -z "$SCOPE" ]] && return 0
  [[ "$SCOPE" == "release" ]] && return 0
  if [[ "$SCOPE" == "ci" ]]; then
    case "$1" in
      skill|ci_health) return 0 ;;
      *) return 1 ;;
    esac
  fi
  [[ "$SCOPE" == "$1" ]] && return 0
  return 1
}

run_python() {
  if command -v uv >/dev/null 2>&1; then
    uv run python "$@"
  elif command -v python3 >/dev/null 2>&1; then
    python3 "$@"
  else
    return 127
  fi
}

PRISM_GITIGNORE_PATTERNS=(
  "AGENTS.local.md"
  "AGENTS.*.local.md"
  "workspace.*.local"
  "workspace.*.local/"
  "prism.local.yaml"
)
PRISM_GITIGNORE_LEGACY_PATTERNS=(
  "AGENT.local.md"
  "AGENT.*.local.md"
)

resolve_global_gitignore() {
  local configured
  configured=$(git config --global core.excludesfile 2>/dev/null || true)
  if [[ -n "$configured" ]]; then
    echo "${configured/#\~/$HOME}"
    return 0
  fi
  echo "$HOME/.gitignore_global"
}

check_global_gitignore() {
  local path pat missing=()
  path=$(resolve_global_gitignore)
  for pat in "${PRISM_GITIGNORE_PATTERNS[@]}"; do
    if ! grep -qxF "$pat" "$path" 2>/dev/null; then
      missing+=("$pat")
    fi
  done
  if [[ ${#missing[@]} -eq 0 ]]; then
    echo ""
  else
    printf '%s\n' "${missing[@]}"
  fi
}

check_legacy_global_gitignore() {
  local path pat legacy=()
  path=$(resolve_global_gitignore)
  for pat in "${PRISM_GITIGNORE_LEGACY_PATTERNS[@]}"; do
    if grep -qxF "$pat" "$path" 2>/dev/null; then
      legacy+=("$pat")
    fi
  done
  if [[ ${#legacy[@]} -eq 0 ]]; then
    echo ""
  else
    printf '%s\n' "${legacy[@]}"
  fi
}

fix_global_gitignore() {
  local path missing pat legacy=()
  path=$(resolve_global_gitignore)
  missing=()
  while IFS= read -r pat; do
    [[ -n "$pat" ]] && missing+=("$pat")
  done < <(check_global_gitignore)
  while IFS= read -r pat; do
    [[ -n "$pat" ]] && legacy+=("$pat")
  done < <(check_legacy_global_gitignore)

  if [[ ${#missing[@]} -gt 0 ]]; then
    mkdir -p "$(dirname "$path")"
    if ! git config --global core.excludesfile >/dev/null 2>&1; then
      git config --global core.excludesfile "$path"
    fi
    {
      echo ""
      echo "# Prism — local workspace and agent state"
      for pat in "${missing[@]}"; do
        echo "$pat"
      done
    } >> "$path"
    FIX_CONFIG=$((FIX_CONFIG + ${#missing[@]}))
  fi

  if [[ ${#legacy[@]} -gt 0 && -f "$path" ]]; then
    local tmp="${path}.prism.tmp.$$"
    awk -v pats_csv="$(IFS=,; echo "${legacy[*]}")" '
      BEGIN {
        n=split(pats_csv, a, ",")
        for (i=1; i<=n; i++) drop[a[i]]=1
      }
      !($0 in drop) { print }
    ' "$path" > "$tmp" && mv "$tmp" "$path"
    FIX_CONFIG=$((FIX_CONFIG + ${#legacy[@]}))
  fi
}

handle_global_gitignore_stage() {
  local missing_gitignore=() legacy_gitignore=()
  local pat
  while IFS= read -r pat; do
    [[ -n "$pat" ]] && missing_gitignore+=("$pat")
  done < <(check_global_gitignore)
  while IFS= read -r pat; do
    [[ -n "$pat" ]] && legacy_gitignore+=("$pat")
  done < <(check_legacy_global_gitignore)

  if [[ ${#missing_gitignore[@]} -eq 0 && ${#legacy_gitignore[@]} -eq 0 ]]; then
    return 0
  fi

  if $FIX; then
    fix_global_gitignore
    if ! $JSON; then
      [[ ${#missing_gitignore[@]} -gt 0 ]] && \
        echo -e "  ${GREEN}✓${NC} 已补齐全局 gitignore: ${missing_gitignore[*]}"
      [[ ${#legacy_gitignore[@]} -gt 0 ]] && \
        echo -e "  ${GREEN}✓${NC} 已清理全局 gitignore 老 Prism 模式: ${legacy_gitignore[*]}"
    fi
  else
    if [[ ${#missing_gitignore[@]} -gt 0 ]]; then
      WARN_CONFIG=$((WARN_CONFIG + 1))
      if ! $JSON; then
        echo -e "  ${YELLOW}⚠${NC} 全局 gitignore 缺失 Prism 模式: ${missing_gitignore[*]}"
      fi
    fi
    if [[ ${#legacy_gitignore[@]} -gt 0 ]]; then
      WARN_CONFIG=$((WARN_CONFIG + 1))
      if ! $JSON; then
        echo -e "  ${YELLOW}⚠${NC} 全局 gitignore 残留老 Prism 模式（v1.1.3 已废弃）: ${legacy_gitignore[*]}"
      fi
    fi
    if ! $JSON; then
      echo -e "  ${DIM}运行 bin/doctor --scope config --fix 自动补齐 + 清理${NC}"
    fi
  fi
}

# ── Stage 1: 环境 (setup --check) ────
_stage_env() {
  _in_scope env || return 0

  ! $JSON && echo -e "\n${CYAN}[环境]${NC}"
  local out rc=0
  # setup 返回 0=全绿, 1=有错误, 其他视为错误；--fix 时允许 setup 执行非破坏性修复（含 uv 自动安装）。
  if $FIX; then
    out=$("$PRISM_DIR/bin/setup" 2>&1) || rc=$?
  else
    out=$("$PRISM_DIR/bin/setup" --check 2>&1) || rc=$?
  fi

  # 显示非绿色行（日志里的 ✗ 或 ⚠ 开头项）
  if ! $JSON; then
    local noise
    noise=$(echo "$out" | grep -E '(✗|⚠)' 2>/dev/null | sed 's/^/  /' || true)
    if [[ -n "$noise" ]]; then
      echo "$noise"
    fi
  fi

  # 统计：先看退出码；同时尝试从输出末尾抓"N 个错误, N 个警告"模式（yellow 路径）
  local summary_line
  summary_line=$(echo "$out" | grep -oE '[0-9]+ 个错误, [0-9]+ 个警告' 2>/dev/null | tail -1 || true)
  if [[ -n "$summary_line" ]]; then
    ERR_ENV=$(echo "$summary_line" | awk '{print $1}')
    WARN_ENV=$(echo "$summary_line" | awk '{print $3}')
  else
    # 绿色路径：setup 返回 0 且无 summary_line
    ERR_ENV=0
    WARN_ENV=0
  fi
  # 如果 setup 返回非 0 但没抓到数字，兜底记 1 个错误
  if [[ $rc -ne 0 && $ERR_ENV -eq 0 ]]; then
    ERR_ENV=1
  fi

  ! $JSON && echo -e "  ${DIM}→ ${ERR_ENV} 错误, ${WARN_ENV} 警告${NC}"
}

# ── Stage 2: Skill 合规 (validate-skills) ─
_stage_skill() {
  _in_scope skill || return 0

  ! $JSON && echo -e "\n${CYAN}[Skill 合规]${NC}"
  local args=()
  $FIX && args+=("--fix")
  args+=("--json")

  local out rc=0
  out=$("$PRISM_DIR/bin/validate-skills" "${args[@]}" 2>&1) || rc=$?
  # validate-skills --json 最后一行为 JSON
  local json_line
  json_line=$(echo "$out" | tail -1)
  ERR_SKILL=$(echo "$json_line" | grep -oE '"errors":[0-9]+' | grep -oE '[0-9]+' | head -1)
  WARN_SKILL=$(echo "$json_line" | grep -oE '"warnings":[0-9]+' | grep -oE '[0-9]+' | head -1)
  FIX_SKILL=$(echo "$json_line" | grep -oE '"fixed":[0-9]+' | grep -oE '[0-9]+' | head -1)
  ERR_SKILL=${ERR_SKILL:-0}
  WARN_SKILL=${WARN_SKILL:-0}
  FIX_SKILL=${FIX_SKILL:-0}

  if ! $JSON; then
    if [[ $ERR_SKILL -gt 0 ]]; then
      echo -e "  ${RED}✗${NC} ${ERR_SKILL} 个 skill 有 ERROR 级问题"
      echo -e "  ${DIM}运行 bin/validate-skills 查看详情${NC}"
    fi
    if [[ $WARN_SKILL -gt 0 && $FIX_SKILL -eq 0 ]]; then
      echo -e "  ${YELLOW}⚠${NC} ${WARN_SKILL} 个 WARN 级问题（bin/doctor --fix 可自动修复部分）"
    fi
    if [[ $FIX_SKILL -gt 0 ]]; then
      echo -e "  ${GREEN}✓${NC} 已修复 ${FIX_SKILL} 项"
    fi
    [[ $ERR_SKILL -eq 0 && $WARN_SKILL -eq 0 ]] && echo -e "  ${GREEN}✓${NC} 全部合规"
    echo -e "  ${DIM}→ ${ERR_SKILL} 错误, ${WARN_SKILL} 警告, ${FIX_SKILL} 已修${NC}"
  fi
}

# ── Stage 4: CLI 寻址 (doctor_cli.py) ──
_stage_cli() {
  _in_scope cli || return 0

  ! $JSON && echo -e "\n${CYAN}[CLI 寻址]${NC}"
  local cli_script="$PRISM_DIR/bin/doctor_cli.py"
  if [[ ! -f "$cli_script" ]]; then
    ! $JSON && echo -e "  ${YELLOW}⚠${NC} doctor_cli.py 不存在"
    WARN_CLI=$((WARN_CLI + 1))
    return 0
  fi

  local args=()
  $FIX && args+=("--fix")
  $ROLLBACK && args+=("--rollback")
  local out rc=0
  out=$(run_python "$cli_script" "${args[@]}" 2>&1) || rc=$?

  # doctor_cli 退出码: 0=ok, 1=error, 2=warn
  ERR_CLI=$(echo "$out" | run_python -c '
import json, sys
try:
    d = json.loads(sys.stdin.read())
    print(len(d.get("errors", [])))
except Exception:
    print(0)
' 2>/dev/null || echo 0)
  WARN_CLI=$(echo "$out" | run_python -c '
import json, sys
try:
    d = json.loads(sys.stdin.read())
    print(len(d.get("warnings", [])))
except Exception:
    print(0)
' 2>/dev/null || echo 0)
  FIX_CLI=$(echo "$out" | run_python -c '
import json, sys
try:
    d = json.loads(sys.stdin.read())
    print(len(d.get("fixes_applied", [])))
except Exception:
    print(0)
' 2>/dev/null || echo 0)
  ERR_CLI=${ERR_CLI:-0}
  WARN_CLI=${WARN_CLI:-0}
  FIX_CLI=${FIX_CLI:-0}

  if ! $JSON; then
    # 逐条打印 errors + warnings（用字面量 unicode 避免 f-string 反斜杠转义问题）
    echo "$out" | run_python -c '
import json, sys
try:
    d = json.loads(sys.stdin.read())
    for e in d.get("errors", []):
        print("  \u2717 [{0}] {1}".format(e.get("rule"), e.get("msg")))
    for w in d.get("warnings", []):
        print("  \u26a0 [{0}] {1}".format(w.get("rule"), w.get("msg")))
    for f in d.get("fixes_applied", []):
        print("  \u2713 \u5df2\u4fee\u590d [{0}] {1}".format(f.get("rule"), f.get("msg")))
except Exception:
    pass
' 2>/dev/null || true
    [[ $ERR_CLI -eq 0 && $WARN_CLI -eq 0 ]] && echo -e "  ${GREEN}✓${NC} 全部合规"
    echo -e "  ${DIM}→ ${ERR_CLI} 错误, ${WARN_CLI} 警告, ${FIX_CLI} 已修${NC}"
  fi
}

# ── Stage 5: 配置完整性 (prism.local.yaml 必填字段 + 路径可达性) ──
_stage_config() {
  _in_scope config || return 0

  ! $JSON && echo -e "\n${CYAN}[配置完整性]${NC}"
  local config_path="$PRISM_DIR/prism.local.yaml"

  handle_global_gitignore_stage

  if [[ ! -f "$config_path" ]]; then
    ! $JSON && echo -e "  ${RED}✗${NC} prism.local.yaml 不存在：$config_path"
    ERR_CONFIG=1
    return 0
  fi

  # 配置完整性 — 与 Host / relink 共用 current-only resolver，避免解析漂移。
  local report
  report=$(run_python - "$config_path" "$PRISM_DIR/bin/workspace_resolve.py" <<'PYEOF' 2>/dev/null || echo "parse_error"
import importlib.util
import json
import os
import shutil
import sys

config_path, resolver_path = sys.argv[1:]
spec = importlib.util.spec_from_file_location("prism_workspace_resolve", resolver_path)
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
resolved = module.resolve_prism_config(config_path)

err = 0
warn = 0
lines = []
if not resolved:
    print(json.dumps({
        "err": 1,
        "warn": 0,
        "lines": ["\u2717 \u4ec5\u652f\u6301 current named-workspaces \u683c\u5f0f\uff0c\u4e14 default_workspace \u5fc5\u987b\u5b58\u5728"],
    }, ensure_ascii=False))
    raise SystemExit(0)

parsed = resolved["parsed"]
for field in ("device_id", "sdk_path", "default_workspace"):
    if not parsed.get(field):
        lines.append(f"\u2717 \u7f3a\u5fc5\u586b\u5b57\u6bb5: {field}")
        err += 1

sdk_path = resolved.get("sdk_path")
if not sdk_path or not os.path.isabs(sdk_path):
    lines.append(f"\u2717 sdk_path \u975e\u7edd\u5bf9\u8def\u5f84: {sdk_path or ''}")
    err += 1
elif not os.path.isdir(sdk_path):
    lines.append(f"\u2717 sdk_path \u76ee\u5f55\u4e0d\u5b58\u5728: {sdk_path}")
    err += 1

icloud_markers = ("Mobile Documents", "iCloud~md~obsidian")
for workspace_id, workspace in resolved["workspaces"].items():
    root = workspace.get("workspace_root")
    subdir = workspace.get("workspace_subdir")
    if not root or not os.path.isabs(root):
        lines.append(f"\u2717 workspace {workspace_id} root \u975e\u7edd\u5bf9\u8def\u5f84: {root or ''}")
        err += 1
    elif not os.path.isdir(root):
        lines.append(f"\u26a0 workspace {workspace_id} root \u4e0d\u53ef\u8fbe: {root}")
        warn += 1
    if not subdir or os.path.isabs(subdir):
        lines.append(f"\u2717 workspace {workspace_id} workspace_subdir \u5fc5\u987b\u662f\u76f8\u5bf9\u8def\u5f84")
        err += 1
    git_config = workspace.get("workspace_git") or {}
    if git_config.get("enabled") and root and any(marker in root for marker in icloud_markers):
        lines.append(f"\u26a0 workspace {workspace_id} \u540c\u65f6\u542f\u7528 Git \u4e0e iCloud backend\uff0c\u5b58\u5728\u4e92\u65a5\u98ce\u9669")
        warn += 1

skills_path = resolved.get("skills_path")
if skills_path and not os.path.isabs(skills_path):
    lines.append(f"\u26a0 skills_path \u975e\u7edd\u5bf9\u8def\u5f84\uff08\u53ef\u9009\u6269\u5c55\uff09: {skills_path}")
    warn += 1
elif skills_path and not os.path.isdir(skills_path):
    lines.append(f"\u26a0 skills_path \u76ee\u5f55\u4e0d\u5b58\u5728\uff08\u53ef\u9009\u6269\u5c55\uff09: {skills_path}")
    warn += 1

if shutil.which("uv") is None:
    lines.append("\u2717 uv \u672a\u5b89\u88c5\uff08Minimal Reference Installation \u5fc5\u9700\uff09")
    err += 1
if err == 0 and warn == 0:
    lines.append("\u2713 current named-workspaces \u914d\u7f6e\u3001\u8def\u5f84\u4e0e uv \u5747\u53ef\u7528")

print(json.dumps({"err": err, "warn": warn, "lines": lines}, ensure_ascii=False))
PYEOF
)

  if [[ "$report" == "parse_error" || -z "$report" ]]; then
    ! $JSON && echo -e "  ${YELLOW}⚠${NC} 配置解析失败"
    WARN_CONFIG=1
    return 0
  fi

  ERR_CONFIG=$(echo "$report" | run_python -c 'import json,sys;print(json.loads(sys.stdin.read())["err"])' 2>/dev/null || echo 0)
  WARN_CONFIG=$(echo "$report" | run_python -c 'import json,sys;print(json.loads(sys.stdin.read())["warn"])' 2>/dev/null || echo 0)
  ERR_CONFIG=${ERR_CONFIG:-0}
  WARN_CONFIG=${WARN_CONFIG:-0}

  if ! $JSON; then
    echo "$report" | run_python -c '
import json, sys
d = json.loads(sys.stdin.read())
for l in d["lines"]:
    print(f"  {l}")
' 2>/dev/null || true
    echo -e "  ${DIM}→ ${ERR_CONFIG} 错误, ${WARN_CONFIG} 警告${NC}"
  fi
}

# ── Stage 6: CI 自检 (SDK 自包含完整性) ──
# 仅在 SCOPE=ci 时激活；目标：在无 prism.local.yaml / 无 ~/.local/bin / 无 vault 的 CI runner
# 上验证 SDK 自身合同（bin/* +x、bin/prism --version 能启动）。
_stage_ci_health() {
  _in_scope ci_health || return 0

  ! $JSON && echo -e "\n${CYAN}[CI 自检]${NC}"

  # 检查 1：核心 bin/* 可执行权限
  local bin_required=("bin/prism" "bin/setup" "bin/doctor" "bin/setenv" "bin/relink")
  local entry path
  for entry in "${bin_required[@]}"; do
    path="$PRISM_DIR/$entry"
    if [[ ! -f "$path" ]]; then
      ! $JSON && echo -e "  ${RED}✗${NC} 缺少 $entry"
      ERR_CI_HEALTH=$((ERR_CI_HEALTH + 1))
    elif [[ ! -x "$path" ]]; then
      ! $JSON && echo -e "  ${RED}✗${NC} $entry 缺少可执行权限（chmod +x）"
      ERR_CI_HEALTH=$((ERR_CI_HEALTH + 1))
    fi
  done

  # 检查 2：bin/prism 自身能启动（uv 或 python3 fallback 至少一条路径成立）
  local version_out version_rc=0
  version_out=$(PRISM_FALLBACK_QUIET=1 "$PRISM_DIR/bin/prism" --version 2>&1) || version_rc=$?
  if [[ $version_rc -ne 0 ]]; then
    ! $JSON && echo -e "  ${RED}✗${NC} bin/prism --version 无法启动 (rc=$version_rc): $version_out"
    ERR_CI_HEALTH=$((ERR_CI_HEALTH + 1))
  elif [[ -z "$version_out" ]]; then
    ! $JSON && echo -e "  ${YELLOW}⚠${NC} bin/prism --version 输出为空"
    WARN_CI_HEALTH=$((WARN_CI_HEALTH + 1))
  fi

  # 检查 3：runtime 可用性（uv 或 python3 至少一个）
  if command -v uv >/dev/null 2>&1; then
    : # uv 在路径上，最佳
  elif command -v python3 >/dev/null 2>&1; then
    ! $JSON && echo -e "  ${YELLOW}⚠${NC} 仅有 python3 fallback（CI 建议预装 uv 以贴近用户契约）"
    WARN_CI_HEALTH=$((WARN_CI_HEALTH + 1))
  else
    ! $JSON && echo -e "  ${RED}✗${NC} uv 与 python3 均不可用，无法启动 SDK"
    ERR_CI_HEALTH=$((ERR_CI_HEALTH + 1))
  fi

  # 检查 4：VERSION 文件存在（分发包健康度信号）
  if [[ ! -f "$PRISM_DIR/VERSION" ]]; then
    ! $JSON && echo -e "  ${YELLOW}⚠${NC} VERSION 文件缺失（pack 时会回填，dev 仓库正常）"
    WARN_CI_HEALTH=$((WARN_CI_HEALTH + 1))
  fi

  ! $JSON && {
    if [[ $ERR_CI_HEALTH -eq 0 && $WARN_CI_HEALTH -eq 0 ]]; then
      echo -e "  ${GREEN}✓${NC} SDK 自包含合同就绪（bin/* +x、bin/prism --version 启动正常）"
    fi
    echo -e "  ${DIM}→ ${ERR_CI_HEALTH} 错误, ${WARN_CI_HEALTH} 警告${NC}"
  }
}

# ── 主流程 ───────────────────────────
if ! $JSON; then
  echo -e "${CYAN}Prism Doctor${NC}"
  echo "═══════════════════════════════════"
fi

_stage_env
_stage_skill
_stage_cli
_stage_config
_stage_ci_health

TOTAL_ERR=$((ERR_ENV + ERR_SKILL + ERR_CLI + ERR_CONFIG + ERR_CI_HEALTH))
TOTAL_WARN=$((WARN_ENV + WARN_SKILL + WARN_CLI + WARN_CONFIG + WARN_CI_HEALTH))
TOTAL_FIX=$((FIX_SKILL + FIX_CLI + FIX_CONFIG))

# ── 输出总结 ─────────────────────────
if $JSON; then
  # 读取 VERSION 文件（024 T5 · RELEASE_HEALTH.json 增强）
  SDK_VERSION="unknown"
  if [[ -f "$PRISM_DIR/VERSION" ]]; then
    SDK_VERSION=$(head -1 "$PRISM_DIR/VERSION" | tr -d '[:space:]')
  fi
  TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  cat <<EOF
{"version":"$SDK_VERSION","timestamp":"$TIMESTAMP","sdk_root":"$PRISM_DIR","scope":"${SCOPE:-all}","errors":$TOTAL_ERR,"warnings":$TOTAL_WARN,"fixed":$TOTAL_FIX,"env":{"errors":$ERR_ENV,"warnings":$WARN_ENV},"skill":{"errors":$ERR_SKILL,"warnings":$WARN_SKILL,"fixed":$FIX_SKILL},"cli":{"errors":$ERR_CLI,"warnings":$WARN_CLI,"fixed":$FIX_CLI},"config":{"errors":$ERR_CONFIG,"warnings":$WARN_CONFIG,"fixed":$FIX_CONFIG},"ci_health":{"errors":$ERR_CI_HEALTH,"warnings":$WARN_CI_HEALTH}}
EOF
  # --output 模式：将结果写入文件
  if [[ -n "$OUTPUT" ]]; then
    mkdir -p "$(dirname "$OUTPUT")"
    # 重新生成 JSON 写入文件（避免 stdout pipe 问题）
    cat > "$OUTPUT" <<EOF2
{"version":"$SDK_VERSION","timestamp":"$TIMESTAMP","sdk_root":"$PRISM_DIR","scope":"${SCOPE:-all}","errors":$TOTAL_ERR,"warnings":$TOTAL_WARN,"fixed":$TOTAL_FIX,"env":{"errors":$ERR_ENV,"warnings":$WARN_ENV},"skill":{"errors":$ERR_SKILL,"warnings":$WARN_SKILL,"fixed":$FIX_SKILL},"cli":{"errors":$ERR_CLI,"warnings":$WARN_CLI,"fixed":$FIX_CLI},"config":{"errors":$ERR_CONFIG,"warnings":$WARN_CONFIG,"fixed":$FIX_CONFIG},"ci_health":{"errors":$ERR_CI_HEALTH,"warnings":$WARN_CI_HEALTH}}
EOF2
  fi
else
  echo ""
  echo "═══════════════════════════════════"
  if [[ $TOTAL_ERR -gt 0 ]]; then
    echo -e "${RED}✗ Doctor: ${TOTAL_ERR} 错误, ${TOTAL_WARN} 警告${NC}"
  elif [[ $TOTAL_WARN -gt 0 ]]; then
    echo -e "${YELLOW}⚠ Doctor: 0 错误, ${TOTAL_WARN} 警告${NC}"
    $FIX || echo -e "  ${DIM}提示: bin/doctor --fix 可自动修复部分问题${NC}"
  else
    echo -e "${GREEN}✓ Prism 环境完全健康${NC}"
  fi
fi

# 退出码
# - 错误 > 0：exit 1（所有 scope 一致）
# - 警告 > 0：默认 exit 2；ci scope 友好退 0（CI 不应被 WARN 卡住流水线）
if [[ $TOTAL_ERR -gt 0 ]]; then exit 1
elif [[ $TOTAL_WARN -gt 0 ]]; then
  [[ "$SCOPE" == "ci" ]] && exit 0
  exit 2
else exit 0; fi
