#!/usr/bin/env bash
# Prism setenv — 初始化/读取 prism.local.yaml，输出可 source 的环境变量。
#
# 用法:
#   bin/setenv              显示当前配置
#   bin/setenv --init       交互式创建 prism.local.yaml
#   bin/setenv --init --non-interactive  非交互创建（从参数/环境变量读取）
#   bin/setenv --export     输出 export 语句（可 source）
#   bin/setenv --validate   校验 prism.local.yaml 路径是否有效
#   bin/setenv --example    输出 core contract 配置样例
#   source <(bin/setenv --export)   注入环境变量到当前 shell
#
# --non-interactive 环境变量：
#   PRISM_SDK_PATH     SDK 路径（默认当前 Prism 目录）
#   PRISM_SKILLS_PATH  外部 Skills 路径（可选，留空跳过）
#   PRISM_WORKSPACE_ROOT Workspace backend 物理根（默认 ~/.local/share/prism）
#   PRISM_WS_SUBDIR    Workspace 子目录（默认 Workspace）
#   PRISM_ENV_PATH     Env 层路径（可选）
#   PRISM_OBS_PERSONAL 个人知识库 vault 路径（可选）

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PRISM_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
CONFIG="$PRISM_DIR/prism.local.yaml"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
DIM='\033[2m'
NC='\033[0m'

yaml_get() {
  local key="$1"
  (grep "^${key}:" "$CONFIG" 2>/dev/null || true) | sed "s/^${key}: *//"
}

# 多 workspace 格式解析 — 委托自包含 resolver（--config-tsv 为 bash 入口设计）
_resolve_config() {
  local resolver="$PRISM_DIR/bin/workspace_resolve.py"
  [[ -f "$resolver" ]] || return 1
  local runner
  if command -v python3 >/dev/null 2>&1; then runner=(python3)
  elif command -v uv >/dev/null 2>&1; then runner=(uv run python)
  else return 1
  fi
  "${runner[@]}" "$resolver" --config "$CONFIG" --config-tsv 2>/dev/null
}

# 填充 VAULT / WS_SUB / WS_ROOT / DEFAULT_WS / WG_*（成功返回 0）
_load_workspace_fields() {
  VAULT=""; WS_SUB=""; WS_ROOT=""; DEFAULT_WS=""
  WG_ENABLED=""; WG_BRANCH=""; WG_REMOTE=""; WG_DEBOUNCE=""
  WG_INTERVAL_MINUTES=""; WG_LARGE_FILE_MB=""; WG_NOTIFY_SUCCESS=""; WG_NOTIFY_BLOCK=""
  local line k v
  while IFS=$'\t' read -r k v; do
    case "$k" in
      VAULT_PATH) VAULT="$v" ;;
      WS_SUBDIR) WS_SUB="$v" ;;
      WS_ROOT) WS_ROOT="$v" ;;
      DEFAULT_WORKSPACE) DEFAULT_WS="$v" ;;
      WG_ENABLED|WG_BRANCH|WG_REMOTE|WG_DEBOUNCE|WG_INTERVAL_MINUTES|WG_LARGE_FILE_MB|WG_NOTIFY_SUCCESS|WG_NOTIFY_BLOCK)
        eval "$k=\"$v\"" ;;
    esac
  done < <(_resolve_config) || return 1
  [[ -n "$VAULT" ]]
}

show_config() {
  if [[ ! -f "$CONFIG" ]]; then
    echo -e "${RED}✗ prism.local.yaml 不存在，运行 bin/setenv --init 初始化${NC}"
    exit 1
  fi

  local sdk skills vault ws_sub
  sdk=$(yaml_get sdk_path)
  skills=$(yaml_get skills_path)
  if ! _load_workspace_fields; then
    echo -e "${RED}✗ prism.local.yaml 不是 current named-workspaces 格式${NC}" >&2
    exit 1
  fi
  vault="$VAULT"; ws_sub="$WS_SUB"

  local device_id
  device_id=$(yaml_get device_id)

  echo -e "${CYAN}Prism Local Configuration${NC}"
  echo "─────────────────────────────────"
  if [[ -n "$device_id" ]]; then
    echo -e "  设备 ID:       ${GREEN}${device_id}${NC}"
  else
    echo -e "  设备 ID:       ${YELLOW}未设置（重新运行 bin/setenv --init）${NC}"
  fi
  echo -e "  SDK 路径:       ${GREEN}${sdk}${NC}"
  if [[ -n "$skills" ]]; then
    echo -e "  外部 Skills:    ${GREEN}${skills}${NC}"
  else
    echo -e "  外部 Skills:    ${DIM}(未配置，可选)${NC}"
  fi
  echo -e "  Workspace backend: ${GREEN}${vault}${NC}"
  echo -e "  Workspace 子目录: ${ws_sub}"
  echo ""

  local env_p
  env_p=$(yaml_get env_path)
  if [[ -n "$env_p" ]]; then
    echo -e "  Env 层路径:     ${GREEN}${env_p}${NC}"
  else
    echo -e "  Env 层路径:     ${DIM}(未配置，可选)${NC}"
  fi

  local obs_p
  obs_p=$(yaml_get obs_vault)
  if [[ -n "$obs_p" ]]; then
    echo -e "  个人知识库:     ${GREEN}${obs_p}${NC}"
  else
    echo -e "  个人知识库:     ${DIM}(未配置，可选)${NC}"
  fi
  echo ""
  echo -e "  ${CYAN}完整路径:${NC}"
  echo -e "    Workspace: ${vault}/${ws_sub}"
  if [[ -n "$skills" ]]; then
    echo -e "    Skills:    ${skills}"
  fi
  if [[ -n "$env_p" ]]; then
    echo -e "    Env:       ${env_p}"
  fi
  echo ""


  echo -e "  ${CYAN}注册项目:${NC}"
  local resolver="$PRISM_DIR/bin/workspace_resolve.py"
  if [[ -f "$resolver" ]]; then
    local line code path instance ws
    while IFS=$'\t' read -r code path instance ws; do
      [[ -n "$code" ]] && echo -e "    ${code}: ${path} ${DIM}(${ws})${NC}"
    done < <(python3 "$resolver" --config "$CONFIG" --tsv 2>/dev/null || uv run python "$resolver" --config "$CONFIG" --tsv 2>/dev/null)
  fi

  echo ""
  echo -e "  ${CYAN}路径状态:${NC}"
  [[ -d "$sdk" ]] && echo -e "    SDK:       ${GREEN}✓${NC}" || echo -e "    SDK:       ${RED}✗ 不存在${NC}"
  if [[ -n "$skills" ]]; then
    [[ -d "$skills" ]] && echo -e "    Skills:    ${GREEN}✓${NC}" || echo -e "    Skills:    ${YELLOW}⚠ 不存在（可选扩展）${NC}"
  else
    echo -e "    Skills:    ${DIM}⊘ 未配置（可选）${NC}"
  fi
  [[ -d "$vault" ]] && echo -e "    Backend:   ${GREEN}✓${NC}" || echo -e "    Backend:   ${RED}✗ 不存在${NC}"
  [[ -d "${vault}/${ws_sub}" ]] && echo -e "    Workspace: ${GREEN}✓${NC}" || echo -e "    Workspace: ${YELLOW}⚠ 不存在${NC}"
  if [[ -n "$env_p" ]]; then
    [[ -d "$env_p" ]] && echo -e "    Env:       ${GREEN}✓${NC}" || echo -e "    Env:       ${YELLOW}⚠ 不存在${NC}"
  fi
}

do_export() {
  if [[ ! -f "$CONFIG" ]]; then
    echo "# prism.local.yaml not found" >&2
    exit 1
  fi

  local sdk skills vault ws_sub
  sdk=$(yaml_get sdk_path)
  skills=$(yaml_get skills_path)

  local vault="" ws_sub="" ws_root=""
  if ! _load_workspace_fields; then
    echo "# prism.local.yaml is not current named-workspaces format" >&2
    exit 1
  fi
  vault="$VAULT"; ws_sub="$WS_SUB"; ws_root="$WS_ROOT"
  echo "export PRISM_WORKSPACE_ROOT=\"${vault}\""
  echo "export PRISM_WORKSPACE=\"${ws_root}\""
  # workspace_git（定时同步脚本消费）；未配置则不输出，由调用方走默认值
  if [[ -n "$WG_ENABLED" ]]; then
    echo "export PRISM_WORKSPACE_GIT_ENABLED=\"${WG_ENABLED}\""
    echo "export PRISM_WORKSPACE_GIT_BRANCH=\"${WG_BRANCH}\""
    echo "export PRISM_WORKSPACE_GIT_REMOTE=\"${WG_REMOTE}\""
    echo "export PRISM_WORKSPACE_GIT_DEBOUNCE=\"${WG_DEBOUNCE}\""
    echo "export PRISM_WORKSPACE_GIT_INTERVAL_MINUTES=\"${WG_INTERVAL_MINUTES}\""
    echo "export PRISM_WORKSPACE_GIT_LARGE_FILE_MB=\"${WG_LARGE_FILE_MB}\""
    echo "export PRISM_WORKSPACE_GIT_NOTIFY_SUCCESS=\"${WG_NOTIFY_SUCCESS}\""
    echo "export PRISM_WORKSPACE_GIT_NOTIFY_BLOCK=\"${WG_NOTIFY_BLOCK}\""
  fi

  local device_id
  device_id=$(yaml_get device_id)

  echo "export PRISM_DEVICE_ID=\"${device_id}\""
  echo "export PRISM_DIR=\"${sdk}\""
  if [[ -n "$skills" ]]; then
    echo "export PRISM_SKILLS=\"${skills}\""
  fi

  local env_p
  env_p=$(yaml_get env_path)
  if [[ -n "$env_p" ]]; then
    echo "export PRISM_ENV_PATH=\"${env_p}\""
  fi

  local obs_p
  obs_p=$(yaml_get obs_vault)
  if [[ -n "$obs_p" ]]; then
    echo "export PRISM_OBS_PERSONAL=\"${obs_p}\""
    echo "export PRISM_OBS_VAULT=\"${obs_p}\""
  fi

}

do_validate() {
  if [[ ! -f "$CONFIG" ]]; then
    echo -e "${RED}✗ prism.local.yaml 不存在${NC}"
    exit 1
  fi

  echo -e "${CYAN}Prism 配置校验${NC}"
  echo "─────────────────────────────────"
  # 委托 bin/doctor 的配置阶段（内联 parser，自包含）
  exec "$PRISM_DIR/bin/doctor" --scope config
}

do_example() {
  cat <<EOF
# Prism Local Configuration — current named-workspaces contract
# 保存为 prism.local.yaml；本地路径状态，不入版本控制。

device_id: $(hostname -s)
sdk_path: ${PRISM_DIR}

# 可选扩展：不存在时省略
# skills_path: ${HOME}/prism-skills
# env_path: ${HOME}/ArnoDotFiles
# obs_vault: ${HOME}/Documents/Notes

default_workspace: work
workspaces:
  work:
    workspace_root: ${HOME}/.local/share/prism
    workspace_subdir: Workspace

projects:
EOF
}

write_config() {
  local sdk="$1" skills="$2" workspace_root="$3" ws_sub="$4" env_p="${5:-}" obs_p="${6:-}"
  local device_id
  device_id=$(hostname -s)
  {
    echo "# Prism Local Configuration — current named-workspaces contract"
    echo "# 本地路径状态，不入版本控制；由 bin/setenv 初始化。"
    echo
    echo "device_id: ${device_id}"
    echo "sdk_path: ${sdk}"
    [[ -n "$skills" ]] && echo "skills_path: ${skills}"
    [[ -n "$env_p" ]] && echo "env_path: ${env_p}"
    [[ -n "$obs_p" ]] && echo "obs_vault: ${obs_p}"
    echo
    echo "default_workspace: work"
    echo "workspaces:"
    echo "  work:"
    echo "    workspace_root: ${workspace_root}"
    echo "    workspace_subdir: ${ws_sub}"
    echo
    echo "projects:"
  } > "$CONFIG"
}

do_init() {
  if [[ -f "$CONFIG" ]]; then
    if $NON_INTERACTIVE; then
      echo -e "${RED}✗ prism.local.yaml 已存在，非交互模式拒绝覆盖。${NC}" >&2
      exit 1
    fi
    echo -e "${YELLOW}⚠ prism.local.yaml 已存在${NC}"
    read -r -p "覆盖现有配置？已注册的 projects 将丢失 [y/N]: " confirm
    if [[ "${confirm,,}" != "y" ]]; then
      echo "已取消。"
      return
    fi
    cp "$CONFIG" "${CONFIG}.bak.$(date +%Y%m%d%H%M%S)"
  fi

  local sdk skills workspace_root ws_sub env_p obs_p
  if $NON_INTERACTIVE; then
    sdk="${PRISM_SDK_PATH:-$PRISM_DIR}"
    skills="${PRISM_SKILLS_PATH:-}"
    workspace_root="${PRISM_WORKSPACE_ROOT:-$HOME/.local/share/prism}"
    ws_sub="${PRISM_WS_SUBDIR:-Workspace}"
    env_p="${PRISM_ENV_PATH:-}"
    obs_p="${PRISM_OBS_PERSONAL:-}"
  else
    read -r -p "SDK 路径 [${PRISM_DIR}]: " sdk
    sdk="${sdk:-$PRISM_DIR}"
    read -r -p "外部 Skills 路径（可选） []: " skills
    skills="${skills:-}"
    read -r -p "Workspace backend 根 [${HOME}/.local/share/prism]: " workspace_root
    workspace_root="${workspace_root:-$HOME/.local/share/prism}"
    read -r -p "Workspace 子目录 [Workspace]: " ws_sub
    ws_sub="${ws_sub:-Workspace}"
    read -r -p "Env 路径（可选） []: " env_p
    env_p="${env_p:-}"
    read -r -p "个人知识库路径（可选） []: " obs_p
    obs_p="${obs_p:-}"
  fi

  write_config "$sdk" "$skills" "$workspace_root" "$ws_sub" "$env_p" "$obs_p"
  echo -e "${GREEN}✓ 已创建 current named-workspaces 配置${NC}"
  echo -e "使用 ${CYAN}prism host attach --code CODE${NC} 注册项目，再运行 ${CYAN}bin/relink${NC}。"
}

NON_INTERACTIVE=false
ACTION=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --init)             ACTION="init"; shift ;;
    --example)          ACTION="example"; shift ;;
    --export)           ACTION="export"; shift ;;
    --validate)         ACTION="validate"; shift ;;
    --non-interactive)  NON_INTERACTIVE=true; shift ;;
    --help|-h)
      echo "用法: bin/setenv [--init [--non-interactive]|--example|--export|--validate|--help]"
      echo "  (无参数)          显示当前配置"
      echo "  --init            交互式创建 prism.local.yaml"
      echo "  --init --non-interactive  从环境变量读取路径创建配置"
      echo "  --example         输出 core contract 配置样例"
      echo "  --export          输出 export 语句（配合 source 使用）"
      echo "  --validate        校验 prism.local.yaml 字段与路径"
      exit 0
      ;;
    *) echo "未知参数: $1"; exit 1 ;;
  esac
done

case "${ACTION:-show}" in
  init)     do_init ;;
  example)  do_example ;;
  export)   do_export ;;
  validate) do_validate ;;
  show)     show_config ;;
esac
