#!/usr/bin/env bash
# Prism setenv — 初始化/读取 prism.local.yaml，输出可 source 的环境变量。
#
# 用法:
#   bin/setenv              显示当前配置
#   bin/setenv --init       交互式创建 prism.local.yaml
#   bin/setenv --init --non-interactive  非交互创建（从参数/环境变量读取）
#   bin/setenv --export     输出 export 语句（可 source）
#   bin/setenv --validate   校验 prism.local.yaml 路径是否有效
#   bin/setenv --sync       从 Workspace project.yaml 同步项目注册
#   bin/setenv --example    输出 core contract 配置样例
#   source <(bin/setenv --export)   注入环境变量到当前 shell
#
# --non-interactive 环境变量：
#   PRISM_SDK_PATH     SDK 路径（默认当前 Prism 目录）
#   PRISM_SKILLS_PATH  外部 Skills 路径（可选，留空跳过）
#   PRISM_WORKSPACE_ROOT Workspace backend 物理根（默认 ~/.local/share/prism）
#   PRISM_VAULT_PATH   兼容别名；使用 Vault backend 时可传入
#   PRISM_WS_SUBDIR    Workspace 子目录（默认 Workspace）
#   PRISM_ENV_PATH     Env 层路径（可选）
#   PRISM_OBS_PERSONAL 个人知识库 vault 路径（可选）

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PRISM_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
CONFIG="$PRISM_DIR/prism.local.yaml"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
DIM='\033[2m'
NC='\033[0m'

yaml_get() {
  local key="$1"
  (grep "^${key}:" "$CONFIG" 2>/dev/null || true) | sed "s/^${key}: *//"
}

# 多 workspace 格式解析 — 委托 065 的自包含 resolver（--config-tsv 为 bash 入口设计）
_resolve_config() {
  local resolver="$PRISM_DIR/bin/workspace_resolve.py"
  [[ -f "$resolver" ]] || return 1
  local runner
  if command -v uv >/dev/null 2>&1; then runner=(uv run python)
  elif command -v python3 >/dev/null 2>&1; then runner=(python3)
  else return 1
  fi
  "${runner[@]}" "$resolver" --config "$CONFIG" --config-tsv 2>/dev/null
}

# 填充 VAULT / WS_SUB / WS_ROOT / DEFAULT_WS（成功返回 0）
_load_workspace_fields() {
  VAULT=""; WS_SUB=""; WS_ROOT=""; DEFAULT_WS=""
  local line k v
  while IFS=$'\t' read -r k v; do
    case "$k" in
      VAULT_PATH) VAULT="$v" ;;
      WS_SUBDIR) WS_SUB="$v" ;;
      WS_ROOT) WS_ROOT="$v" ;;
      DEFAULT_WORKSPACE) DEFAULT_WS="$v" ;;
    esac
  done < <(_resolve_config) || return 1
  [[ -n "$VAULT" ]]
}

show_config() {
  if [[ ! -f "$CONFIG" ]]; then
    echo -e "${RED}✗ prism.local.yaml 不存在，运行 bin/setenv --init 初始化${NC}"
    exit 1
  fi

  local sdk skills vault ws_sub
  sdk=$(yaml_get sdk_path)
  skills=$(yaml_get skills_path)
  if _load_workspace_fields; then
    vault="$VAULT"; ws_sub="$WS_SUB"
  else
    vault=$(yaml_get workspace_root)
    [[ -z "$vault" ]] && vault=$(yaml_get vault_path)
    ws_sub=$(yaml_get workspace_subdir)
  fi

  local device_id
  device_id=$(yaml_get device_id)

  echo -e "${CYAN}Prism Local Configuration${NC}"
  echo "─────────────────────────────────"
  if [[ -n "$device_id" ]]; then
    echo -e "  设备 ID:       ${GREEN}${device_id}${NC}"
  else
    echo -e "  设备 ID:       ${YELLOW}未设置（运行 bin/setenv --sync 补充）${NC}"
  fi
  echo -e "  SDK 路径:       ${GREEN}${sdk}${NC}"
  if [[ -n "$skills" ]]; then
    echo -e "  外部 Skills:    ${GREEN}${skills}${NC}"
  else
    echo -e "  外部 Skills:    ${DIM}(未配置，可选)${NC}"
  fi
  echo -e "  Workspace backend: ${GREEN}${vault}${NC}"
  echo -e "  Workspace 子目录: ${ws_sub}"
  echo ""

  local env_p
  env_p=$(yaml_get env_path)
  if [[ -n "$env_p" ]]; then
    echo -e "  Env 层路径:     ${GREEN}${env_p}${NC}"
  else
    echo -e "  Env 层路径:     ${DIM}(未配置，可选)${NC}"
  fi

  local obs_p
  obs_p=$(yaml_get obs_vault)
  [[ -z "$obs_p" ]] && obs_p=$(yaml_get obs_vault_personal)
  if [[ -n "$obs_p" ]]; then
    echo -e "  个人知识库:     ${GREEN}${obs_p}${NC}"
  else
    echo -e "  个人知识库:     ${DIM}(未配置，可选)${NC}"
  fi
  echo ""
  echo -e "  ${CYAN}完整路径:${NC}"
  echo -e "    Workspace: ${vault}/${ws_sub}"
  if [[ -n "$skills" ]]; then
    echo -e "    Skills:    ${skills}"
  fi
  if [[ -n "$env_p" ]]; then
    echo -e "    Env:       ${env_p}"
  fi
  echo ""


  echo -e "  ${CYAN}注册项目:${NC}"
  local resolver="$PRISM_DIR/bin/workspace_resolve.py"
  if [[ -f "$resolver" ]]; then
    local line code path instance ws
    while IFS=$'\t' read -r code path instance ws; do
      [[ -n "$code" ]] && echo -e "    ${code}: ${path} ${DIM}(${ws})${NC}"
    done < <(uv run python "$resolver" --config "$CONFIG" --tsv 2>/dev/null || python3 "$resolver" --config "$CONFIG" --tsv 2>/dev/null)
  fi

  echo ""
  echo -e "  ${CYAN}路径状态:${NC}"
  [[ -d "$sdk" ]] && echo -e "    SDK:       ${GREEN}✓${NC}" || echo -e "    SDK:       ${RED}✗ 不存在${NC}"
  if [[ -n "$skills" ]]; then
    [[ -d "$skills" ]] && echo -e "    Skills:    ${GREEN}✓${NC}" || echo -e "    Skills:    ${YELLOW}⚠ 不存在（可选扩展）${NC}"
  else
    echo -e "    Skills:    ${DIM}⊘ 未配置（可选）${NC}"
  fi
  [[ -d "$vault" ]] && echo -e "    Backend:   ${GREEN}✓${NC}" || echo -e "    Backend:   ${RED}✗ 不存在${NC}"
  [[ -d "${vault}/${ws_sub}" ]] && echo -e "    Workspace: ${GREEN}✓${NC}" || echo -e "    Workspace: ${YELLOW}⚠ 不存在${NC}"
  if [[ -n "$env_p" ]]; then
    [[ -d "$env_p" ]] && echo -e "    Env:       ${GREEN}✓${NC}" || echo -e "    Env:       ${YELLOW}⚠ 不存在${NC}"
  fi
}

do_export() {
  if [[ ! -f "$CONFIG" ]]; then
    echo "# prism.local.yaml not found" >&2
    exit 1
  fi

  local sdk skills vault ws_sub
  sdk=$(yaml_get sdk_path)
  skills=$(yaml_get skills_path)

  local vault="" ws_sub="" ws_root=""
  if _load_workspace_fields; then
    vault="$VAULT"; ws_sub="$WS_SUB"; ws_root="$WS_ROOT"
  else
    vault=$(yaml_get workspace_root)
    [[ -z "$vault" ]] && vault=$(yaml_get vault_path)
    ws_sub=$(yaml_get workspace_subdir)
    ws_root="${vault}/${ws_sub}"
  fi
  echo "export PRISM_WORKSPACE_ROOT=\"${vault}\""
  echo "export PRISM_VAULT=\"${vault}\""  # deprecated compatibility alias
  echo "export PRISM_WORKSPACE=\"${ws_root}\""

  local device_id
  device_id=$(yaml_get device_id)

  echo "export PRISM_DEVICE_ID=\"${device_id}\""
  echo "export PRISM_DIR=\"${sdk}\""
  if [[ -n "$skills" ]]; then
    echo "export PRISM_SKILLS=\"${skills}\""
  fi

  local env_p
  env_p=$(yaml_get env_path)
  if [[ -n "$env_p" ]]; then
    echo "export PRISM_ENV_PATH=\"${env_p}\""
  fi

  local obs_p
  obs_p=$(yaml_get obs_vault)
  [[ -z "$obs_p" ]] && obs_p=$(yaml_get obs_vault_personal)
  if [[ -n "$obs_p" ]]; then
    echo "export PRISM_OBS_PERSONAL=\"${obs_p}\""
    echo "export PRISM_OBS_VAULT=\"${obs_p}\""
  fi

}

do_validate() {
  if [[ ! -f "$CONFIG" ]]; then
    echo -e "${RED}✗ prism.local.yaml 不存在${NC}"
    exit 1
  fi

  echo -e "${CYAN}Prism 配置校验${NC}"
  echo "─────────────────────────────────"
  # 委托 bin/doctor 的配置阶段（内联 parser，自包含）
  exec "$PRISM_DIR/bin/doctor" --scope config
}

NON_INTERACTIVE=false
ACTION=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --init)             ACTION="init"; shift ;;
    --example)          ACTION="example"; shift ;;
    --export)           ACTION="export"; shift ;;
    --validate)         ACTION="validate"; shift ;;
    --sync)             ACTION="sync"; shift ;;
    --non-interactive)  NON_INTERACTIVE=true; shift ;;
    --help|-h)
      echo "用法: bin/setenv [--init [--non-interactive]|--example|--export|--validate|--sync|--help]"
      echo "  (无参数)          显示当前配置"
      echo "  --init            交互式创建 prism.local.yaml"
      echo "  --init --non-interactive  从环境变量读取路径创建配置"
      echo "  --example         输出 core contract 配置样例"
      echo "  --export          输出 export 语句（配合 source 使用）"
      echo "  --validate        校验 prism.local.yaml 字段与路径"
      echo "  --sync            从 Workspace project.yaml 同步项目注册"
      exit 0
      ;;
    *) echo "未知参数: $1"; exit 1 ;;
  esac
done

case "${ACTION:-show}" in
  init)     do_init ;;
  example)  do_example ;;
  export)   do_export ;;
  validate) do_validate ;;
  sync)     do_sync ;;
  show)     show_config ;;
esac
