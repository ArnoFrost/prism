#!/usr/bin/env python3
"""prism dist — Prism 4.0 retired-command tombstone.

The mini/full zip packer was a legacy deployment path and is no longer part of
the active 4.0 source tree. Keep this command discoverable so old automation
fails with a precise migration message instead of an unknown-command error.
"""

from __future__ import annotations

import json
import sys


def main() -> int:
    if "--adapter-info" in sys.argv[1:]:
        print(json.dumps({
            "command": "dist",
            "stability": "retired",
            "mode": "archived",
            "available": False,
            "archive": "git history / legacy-3x-final",
        }, ensure_ascii=False, indent=2))
        return 0

    print("✗ `prism dist` 已在 Prism 4.0 退役；mini/full zip 不再是默认交付面。", file=sys.stderr)
    print("  4.0 请使用版本化 SDK 源码与 Minimal Reference Installation。", file=sys.stderr)
    print("  旧 packer 见 Git 历史或 tag `legacy-3x-final`。", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
