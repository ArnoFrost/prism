# Prism Local Configuration — current named-workspaces contract
# 复制为 prism.local.yaml 并按本机路径修改；不入版本控制。
# 生成 SSOT：bin/setenv --example

# 设备标识（hostname -s 自动生成，跨设备路径解析用）
device_id: YOUR_DEVICE_ID

# SDK 路径（Prism 仓库位置）
sdk_path: ~/prism

# 可选：外部 Skills 扩展仓库路径
# skills_path: ~/prism-skills

# 可选：env 层路径（如 ArnoDotFiles）
# env_path: ~/ArnoDotFiles

default_workspace: work
workspaces:
  work:
    workspace_root: ~/.local/share/prism
    workspace_subdir: Workspace
    # 可选：此 backend 的 Git 同步策略；显式 enabled: true 才启用。
    # workspace_git:
    #   enabled: false
    #   branch: master
    #   remote: origin

# 可选：归档技能（缺省时可省略整段；bin/relink 不会自动写入）
# archived_skills:
#   - example-archived-skill

# 注册项目（由 prism host attach --code CODE 写入）
projects:
  PRISM:
    path: ~/prism
    workspace: work
